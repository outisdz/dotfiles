font=JetBrainsMono Nerd Font 10

# Format: #RRGGBBAA
# AA = transparency (FF solid, CC ~80%, 99 ~60%)

background-color=#11111bef
text-color=#cdd6f4ff
border-color=#313244cc
progress-color=over #313244cc

border-size=0
border-radius=10

padding=12
margin=10

width=360
height=320

default-timeout=3500
ignore-timeout=1

icons=1
max-icon-size=96

anchor=top-left
layer=overlay

markup=1
actions=1
history=1

group-by=app-name
sort=-time

[urgency=low]
border-color=#313244cc

[urgency=high]
background-color=#11111be6
border-color=#f38ba8ff
default-timeout=0
